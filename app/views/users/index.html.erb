<%= render template: "layouts/header"%>
<main class = "mt-[82px] py-4 px-[74px] flex-[1_0_auto]">
    <div class = "flex justify-between">
        <div class = "text-xl">
            <h1 class = "text-2xl text-[#333] mb-4">Сведения о аккаунте</h1>
            <h2 class = "text-[#69377c]">Email</h2>
            <span><%= current_user.email %></span>
            <%= button_to 'Редактировать профиль', edit_user_registration_path, :method => :get, class: "text-[#0d61af] text-base leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
            <%= button_to "Удалить аккаунт", registration_path(:user), data: { turbo_confirm: "Вы уверены, что хотите удалить аккаунт? После удаления восстановить его будет невозможно!" }, method: :delete, class: "text-[#0d61af] text-base leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
        </div>
        <%= button_to 'Выйти из аккаунта', destroy_user_session_path, :method => :delete, class: "text-[#0d61af] text-base leading-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
    </div>
</main>
