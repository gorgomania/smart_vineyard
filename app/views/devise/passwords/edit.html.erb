<main class="flex justify-center">
  <div class="mt-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
      <div class="text-[#333] text-[22px] font-bold">
          <span>Изменение пароля</span>
      </div>

      <% flash.each do |type, msg| %>
        <div class = "mt-5 px-3 h-16 w-full border border-red-800 text-red-800 bg-red-200 rounded-lg flex items-center justify-center text-center">
            <%= msg %>
        </div>
      <% end %>
      
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.hidden_field :reset_password_token %>
        
        <div class="field">
          <%= f.label "Новый пароль", class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "title", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]"%>
        </div>
        
        <div class="field">
          <%= f.label "Подтверждение пароля", class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.password_field :password_confirmation, autofocus: true, autocomplete: "title", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]"%>
        </div>

        <div class="actions">
          <%= f.submit "Изменить", class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
</main>
