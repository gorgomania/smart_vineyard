<main class="flex justify-center">
  <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
    <div class="text-[#333] text-[22px] font-bold">
        <span>Изменение пароля</span>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <%= render "shared/float_field", f: f, name: :password, label: t('.new_password'), type: :password_field, html: { autofocus: true, autocomplete: "new-password" } %>
      <%= render "shared/float_field", f: f, name: :password_confirmation, label: t('.confirm_new_password'), type: :password_field, html: { autocomplete: "new-password" } %>

      <div class="actions">
        <%= f.submit t('.change_my_password'), class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</main>
