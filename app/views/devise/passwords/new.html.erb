<main class="flex justify-center">
  <div class="mt-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
    <div class="text-[#333] text-[22px] font-bold">
        <span>Восстановление пароля</span>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "w-full" }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autofocus: true, autocomplete: "title" %>
      </div>

      <div class="actions">
        <%= f.submit t('.send_me_reset_password_instructions'), class: "h-16 w-full max-w-70 bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90 whitespace-normal" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</main>