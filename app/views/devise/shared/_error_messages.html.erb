<% if resource.errors.any? %>
  <div id="error_explanation" class="w-full" data-turbo-temporary>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li class="mt-5 h-16 border border-danger text-danger bg-danger-bg rounded-lg flex items-center justify-center text-center"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
