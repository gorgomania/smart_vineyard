<main class="flex justify-center">
  <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
    <div class="text-ink text-[22px] font-bold text-center">
        <span>Удаление аккаунта</span>
    </div>

    <p class="mt-5 text-ink text-center">
      Вместе с аккаунтом навсегда удалятся все папки, файлы и виноградники. Восстановить их будет невозможно.
    </p>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :delete }) do |f| %>
      <%= render "shared/float_field", f: f, name: :current_password, label: "Текущий пароль", type: :password_field, html: { autofocus: true, autocomplete: "current-password", value: nil } %>

      <div class="actions">
        <%= f.submit "Удалить навсегда", class: "h-16 w-full bg-danger text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to t('devise.shared.links.back'), users_path, data: { controller: "history", action: "history#back" }, class: "text-link text-sm text-center leading-5 mt-5 w-fit cursor-pointer hover:text-brand-bright" %>
  </div>
</main>
