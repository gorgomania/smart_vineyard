<main class="flex justify-center">
  <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
    <div class="text-[#333] text-[22px] font-bold text-center">
        <span>Изменение профиля</span>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]" %>
      </div>

      <div class="field">
        <%= f.label :new_password, class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]" %>
      </div>

      <div class="field">
        <%= f.label :current_password, class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]" %>
      </div>

      <div class="actions">
        <%= f.submit t('.update'), class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>
    
    <%= link_to t('devise.shared.links.back'), "javascript:history.back()", class: "text-[#0d61af] text-sm text-center leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
  </div>
</main>