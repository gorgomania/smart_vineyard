<%# Flash на страницах форм: alert — ошибка, notice — успех (например, «Вход в систему выполнен» от Devise
    после возврата на сохранённую страницу). Сообщение бывает строкой или массивом; служебные ключи
    Devise вроде timedout не показываем %>
<% width = local_assigns.fetch(:width, "w-full") %>
<% flash.each do |type, message| %>
    <% next unless type.to_s.in?(%w[alert notice]) %>
    <% style = type.to_s == "alert" ? "border-danger text-danger bg-danger-bg" : "border-success text-success bg-success-bg" %>
    <% Array(message).each do |msg| %>
        <div class="mt-5 px-3 h-16 <%= width %> border <%= style %> rounded-lg flex items-center justify-center text-center">
            <%= msg %>
        </div>
    <% end %>
<% end %>
