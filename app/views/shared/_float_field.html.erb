<%# locals: (f:, name:, label:, type: :text_field, width: "w-[280px]", div_class: "", html: {}) %>
<%# Поле с ошибкой валидации — красное, и при наведении и фокусе тоже %>
<% error = f.object.respond_to?(:errors) && f.object.errors.include?(name) %>
<div class="field relative mt-5 <%= div_class %>">
  <%= f.send(type, name,
    class: "auth_input peer #{width} px-3 rounded-lg border border-line h-[64px] bg-surface outline-none hover:bg-surface-hover focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014] #{'!border-danger !bg-danger-bg' if error}",
    placeholder: " ",
    **html
  ) %>
  <%= f.label name, label,
    class: "absolute top-[6px] left-[13px] text-muted pointer-events-none text-[13px] leading-4 transition-all duration-150 peer-placeholder-shown:top-[24px] peer-placeholder-shown:text-base peer-focus:!top-[6px] peer-focus:!text-[13px]" %>
</div>
