<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 px-[74px] flex-[1_0_auto]">
    <% flash.each do |type, msg| %>
        <% if type == "alert" %>
            <div class = "flash absolute top-[98px] h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-red-800 text-red-800 bg-red-200 z-10">
                <%= msg %>
            </div>
        <% else %>
            <div class = "flash absolute top-[98px] h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-[#0a9130] text-[#0a9130] bg-[#a0e7b1] z-10">
                <%= msg %>
            </div>
        <% end %>
    <% end %>
    <div id="map" 
        data-controller="map"
        data-map-api-key="<%= Rails.application.credentials.dig(:yandex, :api_key) %>"
        data-map-center=" [44.5947, 33.4756]"
        data-map-zoom="15"
        class="w-full h-[84.5vh]">
    </div>
</main>