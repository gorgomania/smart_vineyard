<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 pr-4.5 flex-[1_0_auto] overflow-hidden">
  <div class = "flex">
    <div class = "flex flex-col min-w-[74px] items-center" data-controller="map-links">
      <%= link_to vineyards_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Список виноградников",  data: { map_links_target: "link", link_type: "list" } do %>
          <%= image_tag "/vineyard_list.png", alt: "Create folder", class: "min-w-8 h-8" %>
      <% end %>

      <%= link_to new_vineyard_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать виноградник", data: { map_links_target: "link", link_type: "create" } do %>
          <%= image_tag "/create_vineyard.png", alt: "Create vineyard", class: "min-w-8 h-8" %>
      <% end %>
    </div>

    <div class="min-w-85 max-w-85 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center mr-4.5 max-h-[84.5vh] overflow-y-auto" data-controller="vineyard-form">
      <div class="text-[#333] text-[22px] font-bold">
          <span>Редактирование</span>
      </div>
        
      <%= form_with model: @vineyard, local: false, html: {class: "w-[280px]" } do |f| %>
        <%= f.hidden_field :reference_side_index, data: { vineyard_form_target: "referenceSideIndex" } %>
        <%= f.hidden_field :reference_vertex_is_first, data: { vineyard_form_target: "referenceVertexIsFirst" } %>
        <%= f.hidden_field :bushes_per_row, value: "[]" %>

        <% if @errors.present? && @errors.any? %>
          <% @errors.each do |msg| %>
            <div class = "mt-5 px-3 h-16 w-full border border-red-800 text-red-800 bg-red-200 rounded-lg flex items-center justify-center text-center">
                <%= msg %>
            </div>
          <% end %>
        <% end %>

        <div class="field">
          <%= f.label "Название", class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.text_field :name, class: "auth_input w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autofocus: true, autocomplete: "name"%>
        </div>

        <div class="field -mt-1">
          <%= f.label "Сорт винограда", class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.text_field :grape_variety, class: "auth_input w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autocomplete: "title"%>
        </div>

        <div class="field -mt-1">
          <%= f.label "Год посадки", class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.text_field :planting_year, class: "auth_input w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autocomplete: "title"%>
        </div>

        <div id="vertices-container"></div>

        <div class="field mt-1">
          <%= f.label "Расстояние между рядами (м)", class: "text-[#69377c] text-sm" %>
          <div class="flex justify-between gap-3">
            <%= f.range_field :row_spacing, in: 2.0..3.0, step: 0.1, value: 3.0, 
                class: "flex-1 accent-[#69377c]", 
                data: { vineyard_form_target: "rowSpacing" } %>
            <span data-vineyard-form-target="rowSpacingValue" class="text-[#69377c] font-bold w-12 text-center">3.0</span>
          </div>
        </div>
        
        <div class="field -mt-1">
          <%= f.label "Расстояние между кустами (м)", class: "text-[#69377c] text-sm" %>
          <div class="flex justify-between gap-3">
            <%= f.range_field :bush_spacing, in: 1.2..1.8, step: 0.1, value: 1.5, 
                class: "flex-1 accent-[#69377c]", 
                data: { vineyard_form_target: "bushSpacing" } %>
            <span data-vineyard-form-target="bushSpacingValue" class="text-[#69377c] font-bold w-12 text-center">1.5</span>
          </div>
        </div>

        <div class="field">
          <%= f.label "Первый ряд (сторона)", class: "text-[#69377c] text-sm" %>
          <div class="flex gap-2 mt-1">
            <button type="button" data-vineyard-form-target="prevSide" class="flex-1 bg-[#f2f2f2] hover:bg-[#e8e8e8] border border-[#e5e5e5] rounded-lg py-2 text-[#69377c] font-medium transition">
              ◀ Предыдущая
            </button>
            <button type="button" data-vineyard-form-target="nextSide" class="flex-1 bg-[#f2f2f2] hover:bg-[#e8e8e8] border border-[#e5e5e5] rounded-lg py-2 text-[#69377c] font-medium transition">
              Следующая ▶
            </button>
          </div>
        </div>

        <div class="field mt-1">
          <%= f.label "Первый куст (вершина)", class: "text-[#69377c] text-sm" %>
          <div class="flex gap-2 mt-1">
            <button type="button" data-vineyard-form-target="firstBushStart" class="flex-1 bg-[#69377c] border border-[#69377c] text-white rounded-lg py-2 font-medium pointer-events-none transition">
              Начальная
            </button>
            <button type="button" data-vineyard-form-target="firstBushEnd" class="flex-1 bg-[#f2f2f2] hover:bg-[#e8e8e8] border border-[#e5e5e5] text-[#69377c] rounded-lg py-2 font-medium transition">
              Конечная
            </button>
          </div>
        </div>

        <div class="field flex-1 min-w-0 -mt-1">
          <%= f.label "Площадь", class: "text-[13px] relative top-[22px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.text_field :area_hectares, class: "w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none cursor-default", readonly: true, autocomplete: "name"%>
        </div>

        <div class="field flex-1 min-w-0 -mt-1">
          <%= f.label "Количество рядов", class: "text-[13px] relative top-[22px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.text_field :total_rows, class: "w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none cursor-default", readonly: true, autocomplete: "name"%>
        </div>

        <div class="field flex-1 min-w-0 -mt-1">
          <%= f.label "Количество кустов", class: "text-[13px] relative top-[22px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
          <%= f.text_field :total_bushes, class: "w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none cursor-default", readonly: true, autocomplete: "name"%>
        </div>

        <div class="actions">
          <%= f.submit "Сохранить", class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        </div>
      <% end %>
      
      <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
    </div>

    <div id="map" 
        data-controller="map"
        data-turbo="false"
        data-map-api-key="<%= Rails.application.credentials.dig(:yandex, :api_key) %>"
        data-map-center="<%= @map_center %>"
        data-map-zoom="<%= @map_zoom %>"
        data-map-mode="<%= @mode %>"
        data-map-multiple-polygons="<%= @vineyards_data.to_json %>"
        data-map-vineyard-data="<%= @vineyard_data.to_json %>"
        class="w-full h-[84.5vh]">
    </div>
  </div>
</main>