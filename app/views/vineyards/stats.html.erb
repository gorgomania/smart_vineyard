<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 px-[74px] flex-[1_0_auto]">
  
  <div data-controller="dashboard-charts" data-dashboard-charts-stats-value="<%= @stats_data.to_json %>">
    
    
    <!-- Общая статистика -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl shadow-sm p-6">
          <h2 class="text-xl font-bold text-[#69377c] mb-4">Cостояние</h2>
        
          <div class="max-w-lg mx-auto">
            <canvas id="total-chart" data-dashboard-charts-target="canvas"></canvas>
          </div>
        </div>
      
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-xl font-bold text-[#69377c] mb-4">Сводка</h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
            <span>Виноградник:</span>
            <span class="font-bold text-[#69377c]"><%= @vineyard.name %></span>
          </div>

          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
            <span>Всего кустов:</span>
            <span class="font-bold text-[#69377c]"> <%= @total_bushes %> </span>
          </div>

          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
            <span>Проанализировано:</span>
            <span class="font-bold text-[#69377c]"><%= @analyzed_bushes %></span>
          </div>

          <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
            <span>Процент анализа:</span>
            <span class="font-bold text-[#69377c]"><%= number_to_percentage(@total_bushes.nonzero? ? (@analyzed_bushes.to_f / @total_bushes) * 100 : 0, precision: 1, format: "%n %", separator: ".") %></span>
          </div>
        </div>

        <div class = "flex justify-center">
          <%= link_to "Выбрать виноградник", select_stats_vineyards_path, class: "flex items-center justify-center w-[50%] h-16 bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        </div>
      </div>
    </div>
  </div>
</main>