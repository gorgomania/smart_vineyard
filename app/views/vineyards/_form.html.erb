<%# Общая разметка создания и редактирования виноградника: отличаются заголовок, кнопка и ссылка «Назад» %>
<%= render template: "layouts/header" %>
<main class="mt-[82px] py-4 pr-4.5 flex-[1_0_auto] overflow-hidden">
  <div class="group flex max-[1000px]:relative" data-controller="panel">
    <div class="flex flex-col min-w-[74px] items-center" data-controller="map-links">
      <%= link_to vineyards_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Список виноградников",  data: { map_links_target: "link", link_type: "list" } do %>
          <%= image_tag "/list.png", alt: "Vineyards list", class: "min-w-8 h-8" %>
      <% end %>

      <%= link_to new_vineyard_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать виноградник", data: { map_links_target: "link", link_type: "create" } do %>
          <%= image_tag "/map-pin-plus.png", alt: "Create vineyard", class: "min-w-8 h-8" %>
      <% end %>

      <button type="button" class="p-[10px] rounded-[12px] hover:bg-[white] min-[1000px]:hidden" data-action="panel#toggle">
          <%= image_tag "/panel-left-open.png", alt: "Open panel", title: "Открыть панель", class: "min-w-8 h-8 group-data-[open]:hidden" %>
          <%= image_tag "/panel-left-close.png", alt: "Close panel", title: "Скрыть панель", class: "min-w-8 h-8 hidden group-data-[open]:block" %>
      </button>

      <%= link_to (@vineyard.persisted? ? vineyard_path(@vineyard) : vineyards_path), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Назад", data: { controller: "history", action: "history#back" } do %>
          <%= image_tag "/arrow-left.png", alt: "Back", class: "min-w-8 h-8" %>
      <% end %>
    </div>

    <div class="contents max-[1000px]:hidden max-[1000px]:group-data-[open]:block max-[1000px]:absolute max-[1000px]:top-0 max-[1000px]:left-[74px] max-[1000px]:z-[2] max-[1000px]:w-[358px] max-[1000px]:max-w-[calc(100%-74px)] max-[1000px]:h-[84.5vh] max-[1000px]:pr-4.5 max-[1000px]:bg-surface">
      <div class="min-w-85 max-w-85 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center mr-4.5 max-h-[84.5vh] overflow-y-auto max-[1000px]:min-w-0 max-[1000px]:max-w-none max-[1000px]:mr-0" data-controller="vineyard-form">
        <div class="text-ink text-[22px] font-bold">
            <span><%= @vineyard.persisted? ? "Редактирование" : "Создание виноградника" %></span>
        </div>
        
        <%= form_with model: @vineyard, local: false, html: {class: "w-full max-w-[280px]" } do |f| %>
          <%= f.hidden_field :reference_side_index, data: { vineyard_form_target: "referenceSideIndex" } %>
          <%= f.hidden_field :reference_vertex_is_first, data: { vineyard_form_target: "referenceVertexIsFirst" } %>

          <% if @vineyard.errors.any? %>
            <% @vineyard.errors.full_messages.each do |msg| %>
              <div class="mt-5 px-3 min-h-16 py-2 [overflow-wrap:anywhere] w-full border border-danger text-danger bg-danger-bg rounded-lg flex items-center justify-center text-center">
                  <%= msg %>
              </div>
            <% end %>
          <% end %>

          <%= render "shared/float_field", f: f, name: :name, label: "Название", width: "w-full", html: { autofocus: true } %>
          <%= render "shared/float_field", f: f, name: :grape_variety, label: "Сорт винограда", width: "w-full", div_class: "" %>
          <%= render "shared/float_field", f: f, name: :planting_year, label: "Год посадки", width: "w-full", div_class: "" %>

          <div id="vertices-container"></div>

          <div class="field mt-1">
            <%= f.label "Расстояние между рядами (м)", class: "text-brand text-sm" %>
            <div class="flex justify-between gap-3">
              <%= f.range_field :row_spacing, in: 2.0..3.0, step: 0.1, 
                  class: "flex-1 accent-brand", 
                  data: { vineyard_form_target: "rowSpacing" } %>
              <span data-vineyard-form-target="rowSpacingValue" class="text-brand font-bold w-12 text-center"><%= f.object.row_spacing %></span>
            </div>
          </div>
        
          <div class="field -mt-1">
            <%= f.label "Расстояние между кустами (м)", class: "text-brand text-sm" %>
            <div class="flex justify-between gap-3">
              <%= f.range_field :bush_spacing, in: 1.2..1.8, step: 0.1, 
                  class: "flex-1 accent-brand", 
                  data: { vineyard_form_target: "bushSpacing" } %>
              <span data-vineyard-form-target="bushSpacingValue" class="text-brand font-bold w-12 text-center"><%= f.object.bush_spacing %></span>
            </div>
          </div>

          <div class="field">
            <%= f.label "Первый ряд (сторона)", class: "text-brand text-sm" %>
            <%# Уже 410px «◀ Предыдущая» и «Следующая ▶» не помещаются в строку — кнопки становятся выше,
                стрелка встаёт над словом у обеих; уже 360px кнопки идут друг под другом и снова в строку %>
            <div class="flex gap-2 mt-1 max-[360px]:flex-col">
              <button type="button" data-vineyard-form-target="prevSide" class="flex-1 flex items-center justify-center gap-1 max-[410px]:flex-col max-[410px]:gap-0 max-[360px]:flex-row max-[360px]:gap-1 bg-surface hover:bg-surface-hover border border-line rounded-lg py-2 text-brand font-medium transition">
                <span>◀</span><span>Предыдущая</span>
              </button>
              <button type="button" data-vineyard-form-target="nextSide" class="flex-1 flex items-center justify-center gap-1 max-[410px]:flex-col max-[410px]:gap-0 max-[360px]:flex-row max-[360px]:gap-1 bg-surface hover:bg-surface-hover border border-line rounded-lg py-2 text-brand font-medium transition">
                <span>Следующая</span><span class="max-[410px]:order-first max-[360px]:order-none">▶</span>
              </button>
            </div>
          </div>

          <div class="field mt-1">
            <%= f.label "Первый куст (вершина)", class: "text-brand text-sm" %>
            <div class="flex gap-2 mt-1">
              <button type="button" data-vineyard-form-target="firstBushStart" class="flex-1 bg-brand border border-brand text-white rounded-lg py-2 font-medium pointer-events-none transition">
                Начальная
              </button>
              <button type="button" data-vineyard-form-target="firstBushEnd" class="flex-1 bg-surface hover:bg-surface-hover border border-line text-brand rounded-lg py-2 font-medium transition">
                Конечная
              </button>
            </div>
          </div>

          <div class="field flex-1 min-w-0 -mt-1">
            <%= f.label "Площадь", class: "text-[13px] relative top-[22px] left-[13px] text-muted pointer-events-none leading-4" %>
            <%= f.text_field :area_hectares, class: "w-full px-3 rounded-lg border border-line h-[64px] bg-surface outline-none cursor-default", readonly: true %>
          </div>

          <div class="field flex-1 min-w-0 -mt-1">
            <%= f.label "Количество рядов", class: "text-[13px] relative top-[22px] left-[13px] text-muted pointer-events-none leading-4" %>
            <%= f.text_field :total_rows, class: "w-full px-3 rounded-lg border border-line h-[64px] bg-surface outline-none cursor-default", readonly: true %>
          </div>

          <div class="field flex-1 min-w-0 -mt-1">
            <%= f.label "Количество кустов", class: "text-[13px] relative top-[22px] left-[13px] text-muted pointer-events-none leading-4" %>
            <%= f.text_field :total_bushes, class: "w-full px-3 rounded-lg border border-line h-[64px] bg-surface outline-none cursor-default", readonly: true %>
          </div>

          <div class="actions">
            <%= f.submit (@vineyard.persisted? ? "Сохранить" : "Создать"), class: "h-16 w-full bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
          </div>
        <% end %>
      </div>
    </div>

    <div id="map" 
        data-controller="map"
        data-turbo="false"
        data-map-api-key="<%= yandex_maps_api_key %>"
        data-map-center="<%= @map_center %>"
        data-map-zoom="<%= @map_zoom %>"
        data-map-mode="<%= @mode %>"
        data-map-multiple-polygons="<%= @vineyards_data.to_json %>"
        data-map-vineyard-data="<%= @vineyard_data.to_json %>"
        class="w-full h-[84.5vh]">
    </div>
  </div>
</main>
