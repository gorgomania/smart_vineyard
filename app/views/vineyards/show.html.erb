<%= render template: "layouts/header" %>
<main class="mt-[82px] py-4 pr-4.5 flex-[1_0_auto]">
    <% flash.each do |type, msg| %>
        <% if type == "alert" %>
            <div class="flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 min-h-16 py-2 [overflow-wrap:anywhere] px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-danger text-danger bg-danger-bg z-10">
                <%= msg %>
            </div>
        <% else %>
            <div class="flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 min-h-16 py-2 [overflow-wrap:anywhere] px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-success text-success bg-success-bg z-10">
                <%= msg %>
            </div>
        <% end %>
    <% end %>
    
    <%# relative на любой ширине: от этой обёртки отсчитываются легенда тепловой карты и (уже 1000px) панель %>
    <div class="group flex relative" data-controller="panel">
        <div class="flex flex-col min-w-[74px] items-center" data-controller="map-links">
            <%= link_to vineyards_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Список виноградников", data: { map_links_target: "link", link_type: "list" } do %>
                <%= image_tag "/list.png", alt: "List", class: "min-w-8 h-8" %>
            <% end %>

            <%= link_to new_vineyard_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать виноградник", data: { map_links_target: "link", link_type: "create" } do %>
                <%= image_tag "/map-pin-plus.png", alt: "Create", class: "min-w-8 h-8" %>
            <% end %>

            <button type="button" class="p-[10px] rounded-[12px] hover:bg-[white] min-[1000px]:hidden" data-action="panel#toggle">
              <%= image_tag "/panel-left-open.png", alt: "Open panel", title: "Открыть панель", class: "min-w-8 h-8 group-data-[open]:hidden" %>
              <%= image_tag "/panel-left-close.png", alt: "Close panel", title: "Скрыть панель", class: "min-w-8 h-8 hidden group-data-[open]:block" %>
            </button>

            <% if @bushes_vision %>
              <%= link_to vineyard_path(@vineyard.id, bushes_vision: false), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Скрыть тепловую карту" do %>
                  <%= image_tag "/eye-off.png", alt: "VisionOff", class: "w-8 h-8" %>
              <% end %>
            <% else %>
              <%= link_to vineyard_path(@vineyard.id, bushes_vision: true), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Показать тепловую карту" do %>
                  <%= image_tag "/eye.png", alt: "VisionOn", class: "w-8 h-8" %>
              <% end %>
            <% end %>

            <%= link_to edit_vineyard_path(@vineyard.id), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Редактировать виноградник" do %>
                <%= image_tag "/pencil.png", alt: "Edit", class: "min-w-8 h-8" %>
            <% end %>
            
            <%= button_to vineyard_path(@vineyard.id), method: :delete, data: { turbo_confirm: "Удалить виноградник \"#{@vineyard.name}\"?" }, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Удалить виноградник" do %>
                <%= image_tag "/trash.png", alt: "Del", class: "min-w-8 h-8" %>
            <% end %>
        </div>
        <div class="contents max-[1000px]:hidden max-[1000px]:group-data-[open]:block max-[1000px]:absolute max-[1000px]:top-0 max-[1000px]:left-[74px] max-[1000px]:z-[3] max-[1000px]:w-[358px] max-[1000px]:max-w-[calc(100%-74px)] max-[1000px]:h-[84.5vh] max-[1000px]:pr-4.5 max-[1000px]:bg-surface">
          <div class="min-w-85 max-w-85 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center mr-4.5 max-h-[84.5vh] overflow-y-auto max-[1000px]:min-w-0 max-[1000px]:max-w-none max-[1000px]:mr-0">
            <div class="text-ink text-[22px] font-bold">
              <span>Виноградник</span>
            </div>

            <div class="w-full max-w-[280px] mt-2">
              <!-- Основная информация -->
              <div class="field">
                <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Название</div>
                <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                  <%= @vineyard.name %>
                </div>
              </div>

              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Сорт винограда</div>
                <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                  <%= @vineyard.grape_variety.presence || "—" %>
                </div>
              </div>

              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Год посадки</div>
                <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                  <%= @vineyard.planting_year.presence || "—" %>
                </div>
              </div>
            
              <!-- Координаты вершин -->
              <div class="mt-4 pt-2 border-t border-line">
                <div class="text-brand text-sm font-medium mb-5">Координаты вершин</div>
                  <% @vineyard.polygon.coordinates[0].each_with_index do |coord, index| %>
                    <% next if index == @vineyard.polygon.coordinates[0].length - 1 %> <%# пропускаем замыкающую точку %>
                    <%# На узкой панели строки не переносим внутри: подпись и пары «Широта: …» целиком,
                        а если не влезают рядом, координаты уходят под подпись и поле растёт по высоте %>
                    <div class="field mt-3 flex flex-wrap items-center justify-between gap-x-3 w-full px-3 py-2 rounded-lg border border-line min-h-[64px] bg-surface-alt">
                      <div class="text-muted pointer-events-none leading-4 whitespace-nowrap">Вершина <%= index + 1 %></div>
                      <%# Сетка из двух колонок: числа начинаются ровно друг под другом, цифры одной ширины %>
                      <div class="grid grid-cols-[auto_auto] gap-x-1 whitespace-nowrap tabular-nums">
                        <span>Широта:</span><span><%= "%.6f" % coord[1] %></span>
                        <span>Долгота:</span><span><%= "%.6f" % coord[0] %></span>
                      </div>
                    </div>
                  <% end %>
              </div>

              <!-- Параметры посадки -->
              <div class="mt-4 pt-2 border-t border-line">
                <div class="text-brand text-sm font-medium mb-2">Параметры посадки</div>
              
                <div class="field -mt-1">
                  <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Расстояние между рядами</div>
                  <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                    <%= @vineyard.row_spacing %> м
                  </div>
                </div>
              
                <div class="field -mt-1">
                  <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Расстояние между кустами</div>
                  <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                    <%= @vineyard.bush_spacing %> м
                  </div>
                </div>
              </div>

              <!-- Статистика -->
              <div class="mt-4 pt-2 border-t border-line">
                <div class="text-brand text-sm font-medium mb-2">Статистика</div>
              
                <div class="field -mt-1">
                  <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Площадь</div>
                  <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                    <%= @vineyard.area_hectares %> га
                  </div>
                </div>

                <div class="field -mt-1">
                  <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Количество рядов</div>
                  <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                    <%= @vineyard.total_rows %>
                  </div>
                </div>

                <div class="field -mt-1">
                  <div class="relative top-[22px] left-[13px] text-[13px] text-muted pointer-events-none leading-4">Количество кустов</div>
                  <div class="w-full px-3 rounded-lg border border-line h-[64px] bg-surface-alt flex items-center">
                    <%= @vineyard.total_bushes %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <% if @bushes_vision %>
          <%# ClassifyMediaJob шлёт сюда heatmap_bush (MediaItem#broadcast_diagnosis): точка куста перекрашивается без перезагрузки %>
          <%= turbo_stream_from @vineyard, :heatmap, id: "heatmap-stream" %>
          <%# Числа кустов присылает map_controller (heatmap:counts), клик по строке прячет класс на карте (heatmap:filter).
              Сворачивается в кнопку с микроскопом: по умолчанию свёрнута уже 710px, а data-state="open|closed",
              который ставит клик по заголовку, сильнее ширины экрана (классы с ! ниже) %>
          <div class="map-legend group/legend absolute bottom-12 right-4 bg-white/95 backdrop-blur-sm p-4 max-[710px]:p-2 data-[state=open]:p-4! data-[state=closed]:p-2! rounded-xl border border-gray-100 z-[2]"
               data-controller="heatmap-legend" data-action="heatmap:counts@document->heatmap-legend#updateCounts">
            <button type="button" class="font-bold text-brand flex items-center gap-2 mb-3 max-[710px]:mb-0 group-data-[state=open]/legend:mb-3! group-data-[state=closed]/legend:mb-0!"
                    title="Свернуть легенду" data-heatmap-legend-target="toggle" data-action="heatmap-legend#toggleOpen mouseenter->heatmap-legend#updateToggleTitle">
              <%= image_tag "/microscope.png", alt: "", class: "w-5 h-5 max-[710px]:w-7 max-[710px]:h-7 group-data-[state=open]/legend:w-5! group-data-[state=open]/legend:h-5! group-data-[state=closed]/legend:w-7! group-data-[state=closed]/legend:h-7!" %>
              <span class="max-[710px]:hidden group-data-[state=open]/legend:inline! group-data-[state=closed]/legend:hidden!">Состояние кустов</span>
            </button>

            <%# Порядок: здоровые, затем болезни; цвета — --color-diag-* из палитры, как у точек на карте %>
            <div class="-mx-2 max-[710px]:hidden group-data-[state=open]/legend:block! group-data-[state=closed]/legend:hidden!" data-heatmap-legend-target="list">
              <% (MediaItem::DIAGNOSES.values_at(2, 1, 0, 3) << MediaItem::NO_DIAGNOSIS).each do |diagnosis| %>
                <button type="button" class="flex items-center gap-3 w-full px-2 py-1 rounded-lg hover:bg-surface aria-[pressed=false]:opacity-40"
                        aria-pressed="true" title="Скрыть «<%= diagnosis[:name] %>» на карте" data-name="<%= diagnosis[:name] %>"
                        data-heatmap-legend-target="row" data-diagnosis="<%= diagnosis[:key] %>" data-action="heatmap-legend#toggle">
                  <div class="w-3.5 h-3.5 rounded-full" style="background: var(--color-diag-<%= diagnosis[:key] %>)"></div>
                  <span class="text-sm text-gray-700"><%= diagnosis[:name] %></span>
                  <span class="ml-auto pl-4 text-sm text-ink-soft tabular-nums" data-heatmap-legend-target="count" data-diagnosis="<%= diagnosis[:key] %>"></span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

        <div id="map" 
            data-controller="map"
            data-turbo="false"
            data-map-api-key="<%= yandex_maps_api_key %>"
            data-map-center="<%= @map_center %>"
            data-map-zoom="<%= @map_zoom %>"
            data-map-mode="<%= @mode %>"
            data-map-vineyard-data="<%= @vineyard_data.to_json %>"
            data-map-heatmap-url="<%= heatmap_vineyard_path(@vineyard, format: :json) if @bushes_vision %>"
            class="w-full h-[84.5vh]">
        </div>
    </div>
</main>
