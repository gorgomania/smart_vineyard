<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 pr-4.5 flex-[1_0_auto]">
    <% flash.each do |type, msg| %>
        <% if type == "alert" %>
            <div class = "flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-red-800 text-red-800 bg-red-200 z-10">
                <%= msg %>
            </div>
        <% else %>
            <div class = "flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-[#0a9130] text-[#0a9130] bg-[#a0e7b1] z-10">
                <%= msg %>
            </div>
        <% end %>
    <% end %>
    
    <div class = "flex">
        <div class = "flex flex-col min-w-[74px] items-center" data-controller="map-links">
            <%= link_to vineyards_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Список виноградников", data: { map_links_target: "link", link_type: "list" } do %>
                <%= image_tag "/vineyard_list.png", alt: "List", class: "min-w-8 h-8" %>
            <% end %>
            <%= link_to new_vineyard_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать виноградник", data: { map_links_target: "link", link_type: "create" } do %>
                <%= image_tag "/create_vineyard.png", alt: "Create", class: "min-w-8 h-8" %>
            <% end %>
            <% if @bushes_vision %>
              <%= link_to vineyard_path(@vineyard.id, bushes_vision: false), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Скрыть тепловую карту" do %>
                  <%= image_tag "/vision_off.png", alt: "VisionOff", class: "w-8 h-8" %>
              <% end %>
            <% else %>
              <%= link_to vineyard_path(@vineyard.id, bushes_vision: true), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Показать тепловую карту" do %>
                  <%= image_tag "/vision_on.png", alt: "VisionOn", class: "w-8 h-8" %>
              <% end %>
            <% end %>
            <%= link_to edit_vineyard_path(@vineyard.id), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Редактировать виноградник" do %>
                <%= image_tag "/pencil_violet.png", alt: "Edit", class: "min-w-8 h-8" %>
            <% end %>
            <%= button_to vineyard_path(@vineyard.id), method: :delete, data: { turbo_confirm: "Удалить виноградник \"#{@vineyard.name}\"?" }, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Удалить виноградник" do %>
                <%= image_tag "/trash_violet.png", alt: "Del", class: "min-w-8 h-8" %>
            <% end %>
        </div>
        <div class="min-w-85 max-w-85 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center mr-4.5 max-h-[84.5vh] overflow-y-auto">
          <div class="text-[#333] text-[22px] font-bold">
            <span>Виноградник</span>
          </div>

          <div class="w-[280px] mt-2">
            <!-- Основная информация -->
            <div class="field">
              <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Название</div>
              <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                <%= @vineyard.name %>
              </div>
            </div>

            <div class="field -mt-1">
              <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Сорт винограда</div>
              <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                <%= @vineyard.grape_variety.presence || "—" %>
              </div>
            </div>

            <div class="field -mt-1">
              <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Год посадки</div>
              <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                <%= @vineyard.planting_year.presence || "—" %>
              </div>
            </div>
            
            <!-- Координаты вершин -->
            <div class="mt-4 pt-2 border-t border-[#e5e5e5]">
              <div class="text-[#69377c] text-sm font-medium mb-5">Координаты вершин</div>
                <% @vineyard.polygon.coordinates[0].each_with_index do |coord, index| %>
                  <% next if index == @vineyard.polygon.coordinates[0].length - 1 %> <%# пропускаем замыкающую точку %>
                  <div class="field mt-3 flex items-center justify-between w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] ">
                    <div class="text-[#8c8c8c] pointer-events-none leading-4">Вершина <%= index + 1 %></div>
                    <div class=" flex flex-col items-center">
                      <span>Широта: <%= "%.6f" % coord[1] %></span>
                      <span>Долгота: <%= "%.6f" % coord[0] %></span>
                    </div>
                  </div>
                <% end %>
            </div>

            <!-- Параметры посадки -->
            <div class="mt-4 pt-2 border-t border-[#e5e5e5]">
              <div class="text-[#69377c] text-sm font-medium mb-2">Параметры посадки</div>
              
              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Расстояние между рядами</div>
                <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                  <%= @vineyard.row_spacing %> м
                </div>
              </div>
              
              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Расстояние между кустами</div>
                <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                  <%= @vineyard.bush_spacing %> м
                </div>
              </div>
            </div>

            <!-- Статистика -->
            <div class="mt-4 pt-2 border-t border-[#e5e5e5]">
              <div class="text-[#69377c] text-sm font-medium mb-2">Статистика</div>
              
              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Площадь</div>
                <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                  <%= @vineyard.area_hectares %> га
                </div>
              </div>

              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Количество рядов</div>
                <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                  <%= @vineyard.total_rows %>
                </div>
              </div>

              <div class="field -mt-1">
                <div class="relative top-[22px] left-[13px] text-[13px] text-[#8c8c8c] pointer-events-none leading-4">Количество кустов</div>
                <div class="w-full px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#fafafa] flex items-center">
                  <%= @vineyard.total_bushes %>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <% if @bushes_vision %>
          <div class="map-legend absolute bottom-12 right-4 bg-white/95 backdrop-blur-sm p-4 rounded-xl border border-gray-100 z-10">
            <div class="font-bold mb-3 text-[#69377c] flex items-center gap-2">
              <span>🔬</span> Состояние кустов
            </div>
            
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-[#2ECC40] shadow-sm"></div>
                <span class="text-sm text-gray-700">Здоровый</span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-[#FF8C00]"></div>
                <span class="text-sm text-gray-700">Эска</span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-[#800000]"></div>
                <span class="text-sm text-gray-700">Чёрная гниль</span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-[#D63384]"></div>
                <span class="text-sm text-gray-700">Листовой ожог</span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-gray-400"></div>
                <span class="text-sm text-gray-700">Нет данных</span>
              </div>
            </div>
          </div>
        <% end %>

        <div id="map" 
            data-controller="map"
            data-turbo="false"
            data-map-api-key="<%= Rails.application.credentials.dig(:yandex, :api_key) %>"
            data-map-center="<%= @map_center %>"
            data-map-zoom="<%= @map_zoom %>"
            data-map-mode="<%= @mode %>"
            data-map-vineyard-data="<%= @vineyard_data.to_json %>"
            data-map-bushes-vision="<%= @bushes_vision.to_json %>"
            class="w-full h-[84.5vh]">
        </div>
    </div>
</main>