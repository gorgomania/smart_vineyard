<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 pr-4.5 flex-[1_0_auto]">
    <% flash.each do |type, msg| %>
        <% if type == "alert" %>
            <div class = "flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-red-800 text-red-800 bg-red-200 z-10">
                <%= msg %>
            </div>
        <% else %>
            <div class = "flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-[#0a9130] text-[#0a9130] bg-[#a0e7b1] z-10">
                <%= msg %>
            </div>
        <% end %>
    <% end %>
    
    <div class = "flex">
        <div class = "flex flex-col min-w-[74px] items-center" data-controller="map-links">
            <%= link_to vineyards_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Список виноградников", data: { map_links_target: "link", link_type: "list" } do %>
                <%= image_tag "/vineyard_list.png", alt: "Vineyards", class: "min-w-8 h-8" %>
            <% end %>
            <%= link_to new_vineyard_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать виноградник", data: { map_links_target: "link", link_type: "create" } do %>
                <%= image_tag "/create_vineyard.png", alt: "Create vineyard", class: "min-w-8 h-8" %>
            <% end %>
        </div>
        <div class="min-w-85 max-w-85  z-[2] flex flex-col gap-2 items-center mr-4.5 max-h-[84.5vh] overflow-y-auto">
            <% if @vineyards.empty? %>
                 <div class = "w-full text-center text-[#69377c] bg-white rounded-2xl p-5"> Для начала работы нужно создать виноградник </div>
            <% end %>
            <% @vineyards.each do |vineyard| %>
                <div class = "flex w-full justify-between bg-white rounded-2xl p-5">
                    <div class = "flex flex-col text-[#333] text-m">
                        <%= link_to vineyard_path(vineyard.id) do %>
                            <span class="text-[#69377c] text-xl font-bold hover:opacity-90"><%= vineyard.name %></span>
                        <% end %>
                        <span> Сорт: <%= vineyard.grape_variety %> </span>
                        <span> Площадь: <%= vineyard.area_hectares %> га </span>
                    </div>
                    <div class = "flex max-w-33 h-fit">
                        <%= link_to edit_vineyard_path(vineyard.id), class: "rounded-lg p-2 hover:bg-[#f2f2f2]", title: "Переименовать" do %>
                            <%= image_tag "/pencil.png", alt: "Edit", class: "w-4 h-4" %>
                        <%end%>
                        <%= button_to vineyard_path(vineyard.id), method: :delete, data: { turbo_confirm: "Удалить виноградник \"#{vineyard.name}\"?" }, class: "rounded-lg p-2 hover:bg-[#f2f2f2]", title: "Удалить" do %>
                            <%= image_tag "/trash.png", alt: "Del", class: "w-4 h-4" %>
                        <%end%>
                    </div>
                </div>
            <% end %>
        </div>
        <div id="map" 
            data-controller="map"
            data-turbo="false"
            data-map-api-key="<%= yandex_maps_api_key %>"
            data-map-center="<%= @map_center %>"
            data-map-zoom="<%= @map_zoom %>"
            data-map-mode="<%= @mode %>"
            data-map-multiple-polygons="<%= @vineyards_data.to_json %>"
            class="w-full h-[84.5vh]">
        </div>
    </div>
</main>
