<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 pr-4.5 flex-[1_0_auto]">
    <% flash.each do |type, msg| %>
        <% if type == "alert" %>
            <div class = "flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-red-800 text-red-800 bg-red-200 z-10">
                <%= msg %>
            </div>
        <% else %>
            <div class = "flash fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 h-16 px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-[#0a9130] text-[#0a9130] bg-[#a0e7b1] z-10">
                <%= msg %>
            </div>
        <% end %>
    <% end %>
    
    <div class = "flex">
        <div class = "flex flex-col min-w-[74px] items-center" data-controller="map-links">
            <%= link_to vineyards_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Режим просмотра", data: { map_links_target: "link", link_type: "list" } do %>
                <%= image_tag "/vineyard_list.png", alt: "Vineyards", class: "min-w-8 h-8" %>
            <% end %>
            <%= link_to new_vineyard_path, class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать виноградник", data: { map_links_target: "link", link_type: "create" } do %>
                <%= image_tag "/create_vineyard.png", alt: "Create vineyard", class: "min-w-8 h-8" %>
            <% end %>
        </div>
        <div id="map" 
            data-controller="map"
            data-turbo="false"
            data-map-api-key="<%= Rails.application.credentials.dig(:yandex, :api_key) %>"
            data-map-center="<%= @map_center %>"
            data-map-zoom="<%= @map_zoom %>"
            data-map-draw="<%= @draw_mode %>"
            class="w-full h-[84.5vh]">
        </div>
    </div>
</main>