<%= render template: "layouts/header" %>
<main class = "mt-[82px] py-4 px-[74px] flex-[1_0_auto]">
  
  <div data-controller="dashboard-charts">
    
    <!-- Общая статистика -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-xl font-bold text-[#69377c] mb-4">Общее состояние</h2>
        <canvas id="total-chart" data-dashboard-charts-target="canvas" class="w-full"></canvas>
      </div>
      
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-xl font-bold text-[#69377c] mb-4">Сводка</h2>
        <div id="quick-stats" class="space-y-3">
          <!-- Заполнится из JS -->
        </div>
      </div>
      
    </div>
    
  </div>
</main>