<header class="fixed top-0 flex justify-beetween bg-white py-4 pl-[74px] pr-[76px] z-10 w-full">
    <%= link_to maps_path, class: "max-w-[162.78px] hover:opacity-[0.9] flex items-center" do %>
        <img src="http://localhost:3000/logo.png" alt="Logo">
    <%end%>
    <%= form_for(:folders, url: :folders, html: { method: :get }, class: "flex ml-[51px] w-full") do |f| %>
        <div class="field w-full">
        <%= f.text_field :title, class: "search_input p-[24px_66px_24px_12px] rounded-[12px] border-0 bg-[#f2f2f2] w-full min-w-61 outline-none", autofocus: true, autocomplete: "name", value: @search_query, placeholder: "Поиск папок и файлов",  required: @search_query.blank? %>
        </div>
        <div class="w-0 h-0">
        <%= f.submit "Поиск", :type => :image, :src => "http://localhost:3000/search.png", class: "search_img relative right-[50px] top-[22px] w-[26px] h-[26px] rounded-[12px] hover:bg-[#f2f2f2] hover:shadow-[0_0_0_10px_#f2f2f2]", title: "Поиск" %>
        </div>
    <% end %>
    <div id = "desktopMenu" class="flex items-end ml-[47px]">
        <%= link_to folders_path, class: "ml-1 p-[10px] flex flex-col justify-between items-center rounded-[12px] w-[140px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <img src="http://localhost:3000/explorer.png" alt="Explorer" class = "min-w-[26px] h-[26px] mb-1">
            <span>Проводник</span>
        <%end%>

        <%= link_to maps_path, class: "ml-1 p-[10px] flex flex-col justify-between items-center rounded-[12px] w-[140px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <img src="http://localhost:3000/map.png" alt="Map" class = "min-w-[26px] h-[26px] mb-1">
            <span>Карта</span>
        <%end%>

        <%= link_to stats_path, class: "ml-1 p-[10px] flex flex-col justify-between items-center rounded-[12px] w-[140px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <img src="http://localhost:3000/result.png" alt="Result" class = "min-w-[26px] h-[26px] mb-1">
            <span>Статистика</span>
        <%end%>

        <%= link_to users_path, class: "ml-1 p-[10px] flex flex-col justify-between items-center rounded-[12px] w-[140px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <img src="http://localhost:3000/profile.png" alt="Result" class = "min-w-[26px] h-[26px] mb-1">
            <span>Профиль</span>
        <%end%>
    </div>
    <button id="burgerMenu" class="hidden ml-[51px] p-5 rounded-lg hover:bg-gray-100 text-[#333]">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <div id="dropMenu" class="hidden absolute top-full left-0 right-0 bg-white shadow-lg border-t border-[#333]">
        <nav class="flex flex-col">
            <%= link_to folders_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do %>
                <img src="http://localhost:3000/explorer.png" class="w-5 h-5">
                <span>Проводник</span>
            <% end %>
            
            <%= link_to maps_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do %>
                <img src="http://localhost:3000/map.png" class="w-5 h-5">
                <span>Карта</span>
            <% end %>
            
            <%= link_to stats_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do %>
                <img src="http://localhost:3000/result.png" class="w-5 h-5">
                <span>Статистика</span>
            <% end %>

            <%= link_to users_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do%>
                <img src="http://localhost:3000/profile.png" alt="Profile" class="w-5 h-5">
                <span>Профиль</span>
            <%end%>
        </nav>
  </div>
  <div id="overlay" class="hidden fixed top-[248.8px] bottom-0 left-0 right-0 bg-black bg-opacity-50 transition-opacity duration-300 ease-in-out opacity-0 pointer-events-none z-5"></div>
</header>