<header class="fixed top-0 flex justify-between bg-white py-4 pl-[74px] pr-[76px] max-[710px]:pl-[37px] max-[710px]:pr-[38px] z-10 w-full" data-controller="nav">
    <%= link_to vineyards_path, class: "hover:opacity-[0.9]" do %>
        <%= image_tag "/logo.png", alt: "Logo", class: "h-[50px]" %>
    <%end%>
    <%= form_for(:folders, url: :folders, html: { method: :get }, class: "flex ml-12 max-[634px]:hidden", data: { controller: "search" }) do |f| %>
        <div class="field w-full">
        <%= f.text_field :title, class: "search_input p-[12px_66px_12px_12px] rounded-[12px] border-0 bg-[#f2f2f2] w-full min-w-61 outline-none hover:bg-white hover:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autocomplete: "name", value: @search_query, placeholder: "Поиск папок и файлов",  required: @search_query.blank?, data: { "search-target": "input" } %>
        </div>
        <div class="w-0 h-0">
        <%= image_submit_tag("/search.png", name: "commit", class: "search_img relative right-[50px] top-[11px] w-[26px] h-[26px] rounded-[12px] hover:bg-[#f2f2f2] hover:shadow-[0_0_0_10px_#f2f2f2]", title: "Поиск", data: { action: "mouseenter->search#imgEnter mouseleave->search#imgLeave" }) %>
        </div>
    <% end %>
    <div id="desktopMenu" class="flex items-end ml-11" data-nav-target="desktopMenu">
        <%= link_to folders_path, title: "Проводник", class: "ml-1 p-3 flex flex-col justify-between items-center rounded-[12px] w-[80px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <%= image_tag "/folder-open.png", alt: "Explorer", class: "min-w-[26px] h-[26px]" %>
        <%end%>

        <%= link_to vineyards_path, title: "Виноградники", class: "ml-1 p-3 flex flex-col justify-between items-center rounded-[12px] w-[80px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <%= image_tag "/map.png", alt: "Map", class: "min-w-[26px] h-[26px]" %>
        <%end%>

        <%= link_to total_stats_vineyards_path, title: "Статистика", class: "ml-1 p-3 flex flex-col justify-between items-center rounded-[12px] w-[80px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <%= image_tag "/chart-column.png", alt: "Stats", class: "min-w-[26px] h-[26px]" %>
        <%end%>

        <%= link_to users_path, title: "Профиль", class: "ml-1 p-3 flex flex-col justify-between items-center rounded-[12px] w-[80px] text-[#4e4e4e] hover:bg-[#f2f2f2]" do %>
            <%= image_tag "/circle-user.png", alt: "Profile", class: "min-w-[26px] h-[26px]" %>
        <%end%>
    </div>
    <%# Иконку меняет aria-expanded, который ставит nav_controller: закрыто — menu, открыто — x %>
    <button id="burgerMenu" type="button" aria-label="Меню" aria-expanded="false" class="group hidden ml-[51px] p-[9px] rounded-lg hover:bg-gray-100" data-nav-target="burgerMenu" data-action="click->nav#toggleMenu">
      <%= image_tag "/menu.png", alt: "", class: "w-8 h-8 group-aria-expanded:hidden" %>
      <%= image_tag "/x.png", alt: "", class: "w-8 h-8 hidden group-aria-expanded:block" %>
    </button>
    <div id="dropMenu" class="hidden absolute top-full left-0 right-0 bg-white shadow-lg border-t border-[#333]" data-nav-target="dropMenu">
        <%= form_for(:folders, url: :folders, html: { method: :get }, class: "flex px-4 py-3 min-[634px]:hidden", data: { controller: "search" }) do |f| %>
            <div class="field w-full">
            <%= f.text_field :title, id: "folders_title_mobile", class: "search_input p-[12px_66px_12px_12px] rounded-[12px] border-0 bg-[#f2f2f2] w-full outline-none hover:bg-white hover:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autocomplete: "name", value: @search_query, placeholder: "Поиск папок и файлов", required: @search_query.blank?, data: { "search-target": "input" } %>
            </div>
            <div class="w-0 h-0">
            <%= image_submit_tag("/search.png", name: "commit", class: "search_img relative right-[50px] top-[11px] w-[26px] h-[26px] rounded-[12px] hover:bg-[#f2f2f2] hover:shadow-[0_0_0_10px_#f2f2f2]", title: "Поиск", data: { action: "mouseenter->search#imgEnter mouseleave->search#imgLeave" }) %>
            </div>
        <% end %>
        <nav class="flex flex-col">
            <%= link_to folders_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do %>
                <%= image_tag "/folder-open.png", alt: "Explorer", class: "w-5 h-5" %>
                <span>Проводник</span>
            <% end %>

            <%= link_to vineyards_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do %>
                <%= image_tag "/map.png", alt: "Map", class: "w-5 h-5" %>
                <span>Виноградники</span>
            <% end %>

            <%= link_to total_stats_vineyards_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do %>
                <%= image_tag "/chart-column.png", alt: "Stats", class: "w-5 h-5" %>
                <span>Статистика</span>
            <% end %>

            <%= link_to users_path, class: "px-4 py-3 hover:bg-[#f2f2f2] flex items-center gap-3" do%>
                <%= image_tag "/circle-user.png", alt: "Profile", class: "w-5 h-5" %>
                <span>Профиль</span>
            <%end%>
        </nav>
  </div>
  <div id="overlay" class="hidden fixed bottom-0 left-0 right-0 bg-black bg-opacity-50 transition-opacity duration-300 ease-in-out opacity-0 pointer-events-none z-5" data-nav-target="overlay" data-action="click->nav#closeMenu"></div>
</header>
