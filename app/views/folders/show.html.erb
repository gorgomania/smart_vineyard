<%= render template: "layouts/header" %>
    <main class = "mt-[106px] py-4 px-[74px] flex-[1_0_auto]">
        <div class = "flex gap-1">
            <%= nav_buttons %>
            <% if @search_query.blank? %>
                <%= link_to new_folder_path(parent_id: @folder.id), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать папку" do %>
                    <img src="http://localhost:3000/create_folder.png" alt="Create folder" class = "min-w-8 h-8">
                <% end %>
                <%= link_to new_media_item_path(folder_id: @folder.id), class: "p-[10px] flex flex-col justify-between items-center rounded-[12px] hover:bg-[white]", title: "Загрузить файлы" do %>
                    <img src="http://localhost:3000/upload_file.png" alt="Upload file" class = "min-w-8 h-8">
                <% end %>
            <% end %>
            <% if @title_path.present?%>
                <div class = "flex items-center bg-white px-4 rounded-lg">
                    <% (0...@title_path.length - 1).each do |i| %>
                        <%= link_to @title_path[i], folder_path(@id_path[i]), class: "text-[#69377c] hover:text-[#8a579f] hover:underline underline-offset-2"%>
                        <span class ="whitespace-pre-wrap text-[#333] font-semibold"> / </span>
                    <% end %>
                    <span class = "text-[#69377c]"> <%= @title_path.last %> </span>
                </div>
            <% end %>
        </div>
        <% flash.each do |type, msg| %>
            <div class = "mt-5 px-3 h-[64px] w-fit border border-[#0a9130] text-[#0a9130] bg-[#a0e7b1] rounded-lg flex items-center justify-center">
                <%= msg %>
            </div>
        <% end %>
        <% if @search_query.present? && @childrens.empty? && @media.empty?%>
            <div class="mt-4 text-[#333]">
                <span> В результате поиска не обнаружено файлов и папок с похожим именем.</span>
            </div>
        <% else %>
            <div class = "mt-4 grid grid-cols-8 gap-[10px]">
                <% @childrens.each do |children| %>
                    <div class = "bg-white rounded-2xl flex flex-col px-4 items-center text-[#333] gap-1 py-1">
                        <div class = "flex justify-end w-full">
                            <%= button_to edit_folder_path(children.id), method: :get, class: "rounded-lg p-2 hover:bg-[#f2f2f2]", title: "Переименовать" do %>
                                <img src="http://localhost:3000/pencil.png" alt="Edit" class = "w-4 h-4">
                            <%end%>
                            <%= button_to folder_path(children.id), method: :delete, data: { turbo_confirm: "Удалить папку '#{children.title}' вместе с содержимым?" }, class: "rounded-lg p-2 hover:bg-[#f2f2f2]", title: "Удалить"  do %>
                                <img src="http://localhost:3000/trash.png" alt="Del" class = "w-4 h-4">
                            <%end%>
                        </div>
                        <%= link_to folder_path(children.id), class: "flex flex-col items-center gap-1" do %>
                            <img src="http://localhost:3000/folder.png" alt="Folder" class = "min-w-33 h-24">
                            <span><%= children.title %></span>
                        <% end %>
                    </div>
                <% end %>
                <% @media.each do |file| %>
                    <% if file.media.attached? %>
                        <div class = "bg-white rounded-2xl flex flex-col px-4 items-center text-[#333] gap-1 py-1">
                            <div class = "flex justify-end w-full">
                                <%= button_to edit_media_item_path(file.id), method: :get, class: "rounded-lg p-2 hover:bg-[#f2f2f2]", title: "Переименовать" do %>
                                    <img src="http://localhost:3000/pencil.png" alt="Edit" class = "w-4 h-4">
                                <%end%>
                                <%= button_to media_item_path(file.id), method: :delete, data: { turbo_confirm: "Удалить файл '#{file.media.filename}'?" }, class: "rounded-lg p-2 hover:bg-[#f2f2f2]", title: "Удалить" do %>
                                    <img src="http://localhost:3000/trash.png" alt="Del" class = "w-4 h-4">
                                <%end%>
                            </div>
                            <%= link_to media_item_path(file.id), class: "flex flex-col items-center gap-1" do %>
                                <% if file.media.image? %>
                                    <%= image_tag file.media, class: "w-33 h-24" %>
                                <% else %>
                                    <div class = "flex flex-col items-center">
                                        <%= image_tag file.video_preview, class: "w-33 h-24" %>
                                        <%= image_tag "http://localhost:3000/video_play.png", class: "w-6 h-6 relative -top-9 -mt-6" %>
                                    </div>
                                <% end %>
                                <span> <%= file.media.filename.to_s[0, 15]%> </span>
                            <% end %>   
                        </div>
                    <% end %>
                <% end %>
            </div>
        <% end %>
        
    </main>
<%= render template: "layouts/footer" %>