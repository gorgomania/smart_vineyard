<%= render template: "layouts/header" %>
<% if @folder %>
    <%# Фоновые задачи загрузки шлют сюда refresh (Folder#broadcast_new_files): страница перерисовывается без перезагрузки %>
    <% turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= turbo_stream_from @folder %>
<% end %>
<main class="mt-[82px] py-4 px-[74px] max-[710px]:px-[37px] flex-[1_0_auto]">
    <div class="relative flex gap-1 justify-between [&_a]:shrink-0 has-[[data-wrapped]]:grid has-[[data-wrapped]]:grid-cols-[1fr_auto]" data-controller="toolbar-fit">
        <div class="flex">
            <%# Иконки — неразрывной группой: при нехватке места прячутся «Вперёд/Назад», а не переносятся %>
            <div class="flex shrink-0">
                <%= nav_buttons %>

                <% if @search_query.blank? %>
                    <%= link_to new_folder_path(parent_id: @folder.id), class: "p-[10px] rounded-[12px] hover:bg-[white]", title: "Создать папку" do %>
                        <%= image_tag "/folder-plus.png", alt: "Create folder", class: "min-w-8 h-8" %>
                    <% end %>

                    <%= link_to new_media_item_path(folder_id: @folder.id), class: "p-[10px] flex flex-col justify-between items-center rounded-[12px] hover:bg-[white]", title: "Загрузить файлы" do %>
                        <%= image_tag "/upload.png", alt: "Upload file", class: "min-w-8 h-8" %>
                    <% end %>
                <% end %>
            </div>

            <% if @search_query.present? && (flash.empty? || flash[:notice].present?) %>
                <div class="flex items-center bg-white px-4 rounded-lg text-brand">
                    <span class="">
                        <%= ru_pluralize(@childrens_length, @media_length, "Найдена", "Найден", "Найдено") %>
                        <%= ru_pluralize(@childrens_length, "папка", "папки", "папок") if @childrens_length > 0 %>
                        <%= " и " if @childrens_length > 0 && @media_length > 0 %>
                        <%= ru_pluralize(@media_length, "медиафайл", "медиафайла", "медиафайлов") if @media_length > 0 %> 
                    </span>
                </div>
            <% end %>

            <%# Flash плавает у правого края строки кнопок (верхней, если путь перенесён) и не сдвигает раскладку.
                Слой обрезает выезд по краю строки — иначе toolbar-fit примет его за переполнение %>
            <% if flash.any? %>
                <div class="absolute inset-x-0 top-0 h-[52px] z-[3] overflow-hidden pointer-events-none flex flex-col items-end">
                    <% flash.each do |type, msg| %>
                        <% if type == "alert" %>
                            <div class="pointer-events-auto max-w-full min-h-[52px] py-2 animate-[flash-in_0.3s_ease-out] px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-danger text-danger bg-danger-bg">
                                <%= msg %>
                            </div>
                        <% else %>
                            <div class="flash pointer-events-auto max-w-full min-h-[52px] py-2 animate-[flash-in_0.3s_ease-out] px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-success text-success bg-success-bg">
                                <%= msg %>
                            </div>
                        <% end %>
                    <% end %>
                </div>
            <% end %>
        </div>

        <% if @title_path.present?%>
            <div class="flex items-center bg-white px-4 rounded-lg mx-1 whitespace-nowrap shrink-0 data-[wrapped]:col-span-full data-[wrapped]:row-start-2 data-[wrapped]:mx-0 data-[wrapped]:min-h-[52px] data-[wrapped]:flex-wrap data-[wrapped]:whitespace-normal data-[wrapped]:[overflow-wrap:anywhere]" data-toolbar-fit-target="path">
                <% (0...@title_path.length - 1).each do |i| %>
                    <%= link_to @title_path[i], folder_path(@id_path[i]), class: "text-brand hover:text-brand-light hover:underline underline-offset-2"%>
                    <span class="whitespace-pre-wrap text-ink font-semibold"> / </span>
                <% end %>

                <span class="text-brand"> <%= @title_path.last %> </span>
            </div>
        <% end %>

        <div class="flex self-start ml-auto">
            <% if @search_query.blank? %>
                <% if @folder.vineyard.present? %>
                    <%= link_to @folder.vineyard.name, vineyard_path(@folder.vineyard), class: "flex items-center bg-white px-4 mr-1 rounded-lg text-brand whitespace-nowrap", title: "Привязанный виноградник", data: { toolbar_fit_target: "vineyard" } %>
                    <%= link_to edit_attach_folder_path(@folder), class: "p-[10px] flex flex-col justify-between items-center rounded-[12px] hover:bg-[white]", title: "Изменить привязанный виноградник" do %>
                        <%= image_tag "/link.png", alt: "Edit attach vineyard", class: "min-w-8 h-8" %>
                    <% end %>
                <% else %>
                    <%= link_to attach_folder_path(@folder), class: "p-[10px] flex flex-col justify-between items-center rounded-[12px] hover:bg-[white]", title: "Связать папку с виноградником" do %>
                        <%= image_tag "/link.png", alt: "Attach vineyard", class: "min-w-8 h-8" %>
                    <% end %>
                <% end %>
            <% end %>
        </div>
    </div>

    <div class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(162.75px,1fr))] gap-[10px]">
        <% @childrens.each do |children| %>
            <div class="bg-white rounded-2xl flex flex-col px-4 items-center text-ink gap-1 py-1">
                <div class="flex justify-end w-full max-w-33">
                    <%= link_to edit_folder_path(children.id, page: @page, search_query: @search_query), class: "rounded-lg p-2 hover:bg-surface", title: "Переименовать" do %>
                        <%= image_tag "/pencil-gray.png", alt: "Edit", class: "w-4 h-4" %>
                    <%end%>

                    <%# Корень попадает сюда через поиск, а удалять его нельзя (FolderPolicy#destroy?) %>
                    <% if policy(children).destroy? %>
                        <%= button_to folder_path(children.id, page: @page, search_query: @search_query), method: :delete, data: { turbo_confirm: "Удалить папку \"#{children.title}\" вместе с содержимым?" }, class: "rounded-lg p-2 hover:bg-surface", title: "Удалить"  do %>
                            <%= image_tag "/trash-gray.png", alt: "Del", class: "w-4 h-4" %>
                        <%end%>
                    <% end %>
                </div>
                <%= link_to folder_path(children.id), class: "flex flex-col items-center gap-1" do %>
                    <%= image_tag "/folder.png", alt: "Folder", class: "min-w-33 h-22" %>

                    <span><%= children.title %></span>
                <% end %>
            </div>
        <% end %>

        <% @media.each do |file| %>
            <% if file.media.attached? %>
                <div class="bg-white rounded-2xl flex flex-col px-4 items-center text-ink gap-1 py-1">
                    <div class="flex justify-end w-full max-w-33">
                        <%= link_to edit_media_item_path(file.id, page: @page, search_query: @search_query), class: "rounded-lg p-2 hover:bg-surface", title: "Переименовать" do %>
                            <%= image_tag "/pencil-gray.png", alt: "Edit", class: "w-4 h-4" %>
                        <%end%>

                        <%= button_to media_item_path(file.id, page: @page, search_query: @search_query), method: :delete, data: { turbo_confirm: "Удалить файл \"#{file.media.filename}\"?" }, class: "rounded-lg p-2 hover:bg-surface", title: "Удалить" do %>
                            <%= image_tag "/trash-gray.png", alt: "Del", class: "w-4 h-4" %>
                        <%end%>
                    </div>
                    
                    <%= link_to media_item_path(file.id), class: "flex flex-col items-center gap-1" do %>
                        <% if file.media.image? %>
                            <%# Скелетон под картинкой прячет image-skeleton, когда она загрузилась: у PNG с прозрачным фоном
                                картинка его не закрывает. Отметку о загрузке контроллер сохраняет при refresh-морфинге %>
                            <div class="group relative w-33 h-22" data-controller="image-skeleton">
                                <div class="absolute inset-0 bg-gray-200 animate-pulse group-data-[loaded]:hidden"></div>
                                
                                <%= image_tag file.media.variant(resize_to_limit: [132, 88]),
                                    class: "relative w-33 h-22",
                                    data: { image_skeleton_target: "image", action: "load->image-skeleton#loaded" },
                                    loading: "lazy" %>
                            </div>
                        <% else %>
                            <%= render "video_preview", file: file %>
                        <% end %>
                        <span> <%= file.media.filename.base.to_s[0, 15]%> </span>
                    <% end %>   
                </div>
            <% end %>
        <% end %>
    </div>
</main>

<% @media.each do |file| %>
  <% unless file.media.image? %>
    <%= turbo_stream_from "media_item_#{file.id}" %>
  <% end %>
<% end %>

<% if @page_limit > 1 %>
    <div class="flex justify-center px-5 bg-white gap-1">
        <!-- Кнопка "Назад" (всегда есть) -->
        <% prev_page = @page == 1 ? @page_limit : @page - 1 %>
        <%= link_to "←", @search_query.present? ? folders_path(folders: { title: @search_query }, page: prev_page) : folder_path(@folder.id, page: prev_page), 
            class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>

        <!-- Всегда показываем 5 страниц: текущая + 2 слева + 2 справа -->
        <% 
            # Всегда отображаем 5 страниц
            start_page = @page - 2
            end_page = @page + 2
            
            # Корректировка
            if start_page == 3
                start_page -= 1
            elsif start_page < 3
                end_page = end_page + (3 - start_page)
                start_page = 1
            end
            
            if end_page == @page_limit - 2
                end_page += 1
            elsif end_page > @page_limit - 2
                start_page = start_page - (end_page + 2 - @page_limit)
                end_page = @page_limit
            end
            
            # Обрезаем до допустимых значений
            start_page = [start_page, 1].max
            end_page = [end_page, @page_limit].min
        %>
        
        <!-- Первая страница и многоточие -->
        <% if start_page > 1 %>
            <%= link_to 1, @search_query.present? ? folders_path(folders: { title: @search_query }, page: 1) : folder_path(@folder.id, page: 1), 
                class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>
            <% if start_page > 2 %>
                <%= link_to "...", select_page_folders_path(
                    id: @folder,
                    search_query: @search_query,
                    range_start: 2,                 
                    range_end: start_page - 1),
                    title: "Выбор страницы",
                    class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>
            <% end %>
        <% end %>
        
        <!-- Страницы -->
        <% (start_page..end_page).each do |i| %>
            <% if i == @page %>
                <button class="bg-white w-12 h-12 rounded-none text-brand font-bold border-b-[3px] border-solid border-brand">
                <span class="block mt-[3px]"><%= i %></span>
                </button>
            <% else %>
                <%= link_to i, @search_query.present? ? folders_path(folders: { title: @search_query }, page: i) : folder_path(@folder.id, page: i), 
                    class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>
            <% end %>
        <% end %>
        
        <!-- Последняя страница и многоточие -->
        <% if end_page < @page_limit %>
        <% if end_page < @page_limit - 1 %>
            <%= link_to "...", select_page_folders_path(
                id: @folder, 
                search_query: @search_query,
                range_start: end_page + 1,
                range_end: @page_limit - 1),
                title: "Выбор страницы",
                class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>
        <% end %>
        <%= link_to @page_limit, @search_query.present? ? folders_path(folders: { title: @search_query }, page: @page_limit) : folder_path(@folder.id, page: @page_limit), 
            class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>
        <% end %>
        
        <!-- Кнопка "Вперёд" (всегда есть) -->
        <% next_page = @page == @page_limit ? 1 : @page + 1 %>
        <%= link_to "→", @search_query.present? ? folders_path(folders: { title: @search_query }, page: next_page) : folder_path(@folder.id, page: next_page), 
            class: "flex justify-center items-center bg-white w-12 h-12 rounded-none text-ink-soft font-bold hover:bg-brand-pale hover:text-brand" %>
    </div>
<% end %>
