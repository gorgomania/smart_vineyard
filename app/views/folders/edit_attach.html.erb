<main class="flex justify-center">
    <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
        <div class="text-[#333] text-[22px] font-bold text-center">
            <span>Перекрепление виноградника</span>
        </div>

        <% flash.each do |type, msg| %>
            <div class = "mt-5 px-3 h-16 w-full border border-red-800 text-red-800 bg-red-200 rounded-lg flex items-center justify-center text-center">
                <%= msg %>
            </div>
        <% end %>

        <%= form_with model: @folder, url: update_attach_to_vineyard_folder_path(@folder), html: { method: :patch }, class: "mt-5 w-70" do |form| %>
            <div class = "flex flex-col gap-5">
                <div>
                    <%= select_tag :vineyard_id, 
                        options_from_collection_for_select(@vineyards, :id, :name, @selected_vineyard_id),
                        include_blank: "- Выберите виноградник -",
                        required: true,
                        class: "w-full px-4 py-3 border border-[#e5e5e5] rounded-lg outline-none focus:border-[#69377c] focus:ring-1 focus:ring-[#69377c] bg-white"
                    %>
                </div>
            </div>

            <%= form.submit 'Сохранить', class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        <% end %>

        <%= button_to 'Открепить виноградник', detach_from_vineyard_folder_path(@folder), method: :delete, data: { turbo_confirm: "Открепить папку от виноградника вместе с содержимым?" }, class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90", form_class: "w-full" %>

        <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
    </div>
</main>