<main class="flex justify-center">
  <div class="mt-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
      <div class="text-ink text-[22px] font-bold">
          <span>Создание папки</span>
      </div>

      <%= render "shared/form_flash" %>

      <%= form_for(@folder, as: :folders, url: folders_path, html: { method: :post }) do |f| %>
        <%= f.hidden_field :parent_id, value: @parent_id %>
        <%= f.hidden_field :page, value: @page %>

        <%= render "shared/float_field", f: f, name: :title, label: "Название", html: { autofocus: true } %>

        <div class="actions">
          <%= f.submit "Создать", class: "h-16 w-full bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        </div>
      <% end %>

      <%= link_to "Назад", (@parent_id.present? ? folder_path(@parent_id) : folders_path), data: { controller: "history", action: "history#back" }, class: "text-link text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-brand-bright" %>
    </div>
</main>
