<main class="flex justify-center">
    <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
        <div class="text-ink text-[22px] font-bold text-center">
            <span>Выбор страницы</span>
        </div>
        <% flash.each do |type, msg| %>
            <div class="mt-5 px-3 h-16 w-full border border-danger text-danger bg-danger-bg rounded-lg flex items-center justify-center text-center">
                <%= msg %>
            </div>
        <% end %>
        <%= form_tag select_page_folders_path, method: :post, class: "mt-5 w-70" do %>
            <%= hidden_field_tag :id, @folder.id if @folder %>
            <%= hidden_field_tag :search_query, @search_query if @search_query.present? %>

            <div class="flex flex-col gap-5">
                <div>
                    <%= select_tag :page, 
                        options_for_select((@range_start..@range_end).map { |p| ["Страница #{p}", p] }),
                        include_blank: "- Выберите страницу -",
                        required: true,
                        class: "w-full px-4 py-3 border border-line rounded-lg outline-none focus:border-brand focus:ring-1 focus:ring-brand bg-white"
                    %>
                </div>
            </div>
            
            <%= submit_tag 'Перейти', class: "h-16 w-full bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        <% end %>
        <%# Без истории — туда же, куда ведёт выбор страницы (FoldersController#select_page): к поиску, в папку или в корень %>
        <% back_path = @search_query.present? ? folders_path(folders: { title: @search_query }) : (@folder ? folder_path(@folder) : folders_path) %>
        <%= link_to "Назад", back_path, data: { controller: "history", action: "history#back" }, class: "text-link text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-brand-bright" %>
    </div>
</main>