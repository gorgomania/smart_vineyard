<div id="video-preview-<%= file.id %>" class="relative flex flex-col items-center">
  <% if file.video_preview.attached? %>
    <%# Скелетон под картинкой, как в folders/show: прячет image-skeleton, когда картинка загрузилась %>
    <div class="group w-33 h-22 relative" data-controller="image-skeleton">
      <div class="absolute inset-0 bg-gray-200 animate-pulse group-data-[loaded]:hidden"></div>

      <%= image_tag file.video_preview,
        class: "relative w-33 h-22",
        data: { image_skeleton_target: "image", action: "load->image-skeleton#loaded" },
        loading: "lazy" %>
    </div>
  <% else %>
    <div class="w-33 h-22 bg-gray-200 animate-pulse"></div>
  <% end %>
  
  <div class="absolute inset-0 flex items-center justify-center">
    <%= image_tag "/circle-play-gray.png", class: "w-12 h-12" %>
  </div>
</div>