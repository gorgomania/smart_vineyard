<main class="flex justify-center">
  <div class="mt-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
    <div class="text-[#333] text-[22px] font-bold">
        <span>Редактирование папки</span>
    </div>
    
    <% flash.each do |type, msg| %>
      <div class = "mt-5 px-3 h-16 w-full border border-red-800 text-red-800 bg-red-200 rounded-lg flex items-center justify-center text-center">
          <%= msg %>
      </div>
    <% end %>

    <%= form_for(:folders, url: folder_path(@folder.id), html: { method: :patch }) do |f| %>
      <%= f.hidden_field :page, value: @page %>
      <%= f.hidden_field :search_query, value: @search_query %>
    
      <div class="field">
        <%= f.label "Название", class: "relative top-[42px] left-[13px] text-[#8c8c8c] pointer-events-none leading-4" %>
        <%= f.text_field :title, class: "auth_input w-[280px] px-3 rounded-lg border border-[#e5e5e5] h-[64px] bg-[#f2f2f2] outline-none hover:bg-[#e8e8e8] focus:bg-white focus:shadow-[0_0_0_1px_#0000000a,0_4px_4px_#0000000a,0_20px_40px_#00000014]", autofocus: true, autocomplete: "title", value: @folder.title%>
      </div>

      <div class="actions">
        <%= f.submit "Сохранить", class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
      </div>
    <% end %>

    <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
  </div>
</main>