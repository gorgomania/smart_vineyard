<main class="flex justify-center">
    <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
        <div class="text-ink text-[22px] font-bold text-center">
            <span>Прикрепление виноградника</span>
        </div>
        <%= render "shared/form_flash" %>
        <%= form_with model: @folder, url: attach_to_vineyard_folder_path(@folder), html: { method: :post }, class: "mt-5 w-70" do |form| %>
            <div class="flex flex-col gap-5">
                <div>
                    <%= select_tag :vineyard_id, 
                        options_from_collection_for_select(@vineyards, :id, :name, @selected_vineyard_id),
                        include_blank: @vineyards.any? ? "- Выберите виноградник -" : "- Нет свободных виноградников -",
                        required: true,
                        class: "w-full px-4 py-3 border border-line rounded-lg outline-none focus:border-brand focus:ring-1 focus:ring-brand bg-white"
                    %>
                </div>
            </div>
            <%= form.submit 'Прикрепить', class: "h-16 w-full bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        <% end %>
        <%= link_to "Назад", folder_path(@folder), data: { controller: "history", action: "history#back" }, class: "text-link text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-brand-bright" %>
    </div>
</main>