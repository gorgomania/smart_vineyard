<main class="flex justify-center">
    <div class="mt-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
        <div class="text-[#333] text-[22px] font-bold">
            <span>Редактирование файла</span>
        </div>
        <% flash.each do |type, msg| %>
            <div class="mt-5 px-3 h-16 w-full border border-red-800 text-red-800 bg-red-200 rounded-lg flex items-center justify-center text-center">
                <%= msg %>
            </div>
        <% end %>
        <%= form_for(:media_item, url: media_item_path(@media_item.id), html: { method: :patch }) do |f| %>
            <%= hidden_field_tag :page, @page %>
            <%= hidden_field_tag :search_query, @search_query %>

            <%= render "shared/float_field", f: f, name: :filename, label: "Название",
                  html: { autofocus: true, autocomplete: "title", value: @media_item.media.filename.base } %>

            <div class="actions">
                <%= f.submit "Сохранить", class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
            </div>
        <% end %>

        <%= link_to "Назад", "#", data: { controller: "history", action: "history#back" }, class: "text-[#0d61af] text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
    </div>
</main>
