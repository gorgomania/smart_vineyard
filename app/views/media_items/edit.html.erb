<main class="flex justify-center">
    <div class="mt-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
        <div class="text-ink text-[22px] font-bold">
            <span>Редактирование файла</span>
        </div>
        <%= render "shared/form_flash" %>
        <%= form_for(:media_item, url: media_item_path(@media_item.id), html: { method: :patch }) do |f| %>
            <%= hidden_field_tag :page, @page %>
            <%= hidden_field_tag :search_query, @search_query %>

            <%= render "shared/float_field", f: f, name: :filename, label: "Название",
                  html: { autofocus: true, value: @media_item.media.filename.base, data: { controller: "select-all" } } %>

            <div class="actions">
                <%= f.submit "Сохранить", class: "h-16 w-full bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
            </div>
        <% end %>

        <%= link_to "Назад", folder_path(@media_item.folder_id), data: { controller: "history", action: "history#back" }, class: "text-link text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-brand-bright" %>
    </div>
</main>
