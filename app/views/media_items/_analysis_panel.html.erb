<div id="analysis-panel-<%= media_item.id %>" class="flex flex-col justify-end w-[20%]">
  <% if media_item.ai_class_id.present? %>
    <div class="text-[#333] text-xl">
      <h1 class="text-2xl text-center mb-4">Результаты анализа</h1>
      <h2 class="text-[#69377c]">Класс</h2>
      <span><%= class_names[media_item.ai_class_id] %> </span>
      <h2 class="text-[#69377c]">Уверенность</h2>
      <span><%= number_to_percentage(media_item.ai_confidence * 100, precision: 2) %> </span>
      <h2 class="text-[#69377c]">Дата классификации</h2>
      <span><%= media_item.ai_classified_at.in_time_zone("Moscow").strftime("%d.%m.%Y %H:%M") %> </span>
    </div>
  <% end %>
  <% if local_assigns[:processing] %>
    <button disabled class="h-16 mt-5 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg border-0 opacity-60 cursor-not-allowed">
      ⏳ В обработке...
    </button>
  <% else %>
    <%= button_to media_item.ai_class_id.present? ? "Реанализ" : "Анализ",
          classify_media_item_path(media_item.id),
          method: :post,
          class: "h-16 mt-5 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
  <% end %>
</div>
