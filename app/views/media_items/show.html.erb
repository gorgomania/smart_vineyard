<%= render template: "layouts/header" %>
<%= turbo_stream_from "media_item_#{@media_item.id}" %>
<main class="mt-[82px] py-4 px-[74px] max-[710px]:px-[37px] flex-[1_0_auto] max-h-[84.5vh] max-[1000px]:max-h-none">
    <%# Как в проводнике: не влезает — путь уходит на свою строку, затем прячутся «Вперёд/Назад» (toolbar-fit) %>
    <div class="group/toolbar relative flex gap-1 [&_a]:shrink-0 has-[[data-wrapped]]:flex-wrap" data-controller="toolbar-fit">
        <div class="flex shrink-0">
            <%= nav_buttons %>
            <%= link_to rails_blob_path(@media_item.media, disposition: "attachment"), class: "p-[10px] flex flex-col justify-between items-center rounded-[12px] hover:bg-[white]", title: "Скачать файл" do %>
                <%= image_tag "/download.png", alt: "Download file", class: "min-w-8 h-8" %>
            <% end %>

            <%# Flash как в проводнике: плавает у правого края строки кнопок, а если путь перенесён на свою строку — у края строки пути; раскладку не сдвигает.
                Слой внутри группы иконок, а не прямым потомком строки: toolbar-fit проверяет переполнение прямых потомков
                и принял бы выезд за нехватку места. Слой обрезает выезд по краю строки %>
            <% if flash.any? %>
                <div class="absolute inset-x-0 top-0 group-has-[[data-wrapped]]/toolbar:top-[56px] h-[52px] z-[3] overflow-hidden pointer-events-none flex flex-col items-end">
                    <% flash.each do |type, msg| %>
                        <% if type == "alert" %>
                            <div class="pointer-events-auto max-w-full min-h-[52px] py-2 animate-[flash-in_0.3s_ease-out] px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-danger text-danger bg-danger-bg">
                                <%= msg %>
                            </div>
                        <% else %>
                            <div class="flash pointer-events-auto max-w-full min-h-[52px] py-2 animate-[flash-in_0.3s_ease-out] px-3 w-fit border rounded-lg flex items-center justify-center transition-opacity duration-500 border-success text-success bg-success-bg">
                                <%= msg %>
                            </div>
                        <% end %>
                    <% end %>
                </div>
            <% end %>
        </div>
        <div class="flex items-center bg-white px-4 rounded-lg whitespace-nowrap shrink-0 data-[wrapped]:basis-full data-[wrapped]:min-h-[52px] data-[wrapped]:flex-wrap data-[wrapped]:whitespace-normal data-[wrapped]:[overflow-wrap:anywhere]" data-toolbar-fit-target="path">
            <% (0...@title_path.length - 1).each do |i| %>
                <%= link_to @title_path[i], folder_path(@id_path[i]), class: "text-brand hover:text-brand-light hover:underline underline-offset-2"%>
                <span class="whitespace-pre-wrap text-ink font-semibold"> / </span>
            <% end %>
            <span class="text-brand"> <%= @title_path.last %> </span>
        </div>
    </div>
    <%# 1000px+ — четыре колонки, 710–1000px — сетка 2×2, уже — одна колонка %>
    <div class="flex justify-between items-start text-ink mt-4 max-[1000px]:grid max-[1000px]:grid-cols-2 max-[1000px]:gap-6 max-[710px]:grid-cols-1">
        <% if @media_item.media.image? %>
            <div class="w-[30%] max-[1000px]:w-auto">
                <%= image_tag @media_item.media, loading: "lazy", class: "w-full max-h-[calc(100vh-150px)] object-contain" %>
            </div>
            
            <%= render "analysis_panel", media_item: @media_item, class_names: @class_names %>

            <div class="w-[20%] max-[1000px]:w-auto text-xl">
                <h1 class="text-2xl text-ink text-center mb-4">Виноградник</h1>
                <% if @media_item.bush.present? %>
                    <h2 class="text-brand">Название</h2>
                    <span><%= @media_item.vineyard_name %> </span>                
                    <h2 class="text-brand">
                        Ряд <span class="text-ink"><%= @media_item.row_number %></span> 
                        Куст <span class="text-ink"><%= @media_item.bush.bush_number %></span>
                    </h2>
                <% else %>
                    <span class="flex text-center"> Позиция на винограднике не определена </span>
                <% end %>
                <% if @media_item.bush.present? %>
                        <%= link_to "Перекрепить к кусту", edit_attach_media_item_path(@media_item), class: "h-16 mt-5 w-full text-base bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90 flex items-center justify-center" %>
                        <%= button_to "Открепить от куста", 
                                detach_from_bush_media_item_path(@media_item), 
                                method: :delete,
                                data: { turbo_confirm: "Открепить файл от куста?" },
                                class: "h-16 mt-5 w-full text-base bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90 flex items-center justify-center" %>
                <% else %>
                    <%= link_to "Прикрепить к кусту", attach_media_item_path(@media_item), class: "h-16 mt-5 w-full text-base bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90 flex items-center justify-center" %>
                <% end %>
            </div>
        <% else %>
            <%= video_tag rails_storage_redirect_path(@media_item.media.blob, disposition: 'inline'),
                controls: true,
                controlsList: "nodownload",
                class: "max-w-[70%] max-[1000px]:max-w-full",
                data: { video_id: @media_item.id } %>
        <% end %>

        <div class="w-[20%] max-[1000px]:w-auto text-xl">
            <h1 class="text-2xl text-ink text-center mb-4">Сведения о файле</h1>
            <h2 class="text-brand">Имя</h2>
            <span class="break-all"><%= @media_item.media.blob.filename.base%> </span>
            <h2 class="text-brand">Расширение</h2>
            <span><%= @media_item.media.blob.filename.extension%> </span>
            <h2 class="text-brand">Размер</h2>
            <span><%= number_to_human_size(@media_item.media.byte_size)%> </span>
        </div>
    </div>
</main>
