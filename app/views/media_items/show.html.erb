<%= render template: "layouts/header" %>
<main class = "mt-[106px] py-4 px-[74px] flex-[1_0_auto]">
    <div class = "flex gap-1">
        <%= nav_buttons %>
        <%= link_to rails_blob_path(@media_item.media, disposition: "attachment"), class: "p-[10px] flex flex-col justify-between items-center rounded-[12px] hover:bg-[white]", title: "Скачать файл" do %>
            <img src="http://localhost:3000/download_file.png" alt="Download file" class = "min-w-8 h-8">
        <% end %>
    </div>
    <div class = "flex justify-between items-start text-[#333]">
        <div class = "w-[20%]">
            <h1>Имя</h1>
            <span class = "text-xl"><%= @media_item.media.filename%> </span>
            <h1>Расширение</h1>
            <span class = "text-xl"><%= @media_item.media.blob.filename.extension%> </span>
            <h1>Размер</h1>
            <span class = "text-xl"><%= number_to_human_size(@media_item.media.byte_size)%> </span>
        </div>
        <% if @media_item.media.image? %>
            <%= image_tag @media_item.media, class: "max-w-[50%]" %>
        <% else %>
            <%= video_tag url_for(@media_item.media),
                controls: true,
                controlsList: "nodownload",
                class: "max-w-[50%]",
                data: { video_id: @media_item.id } %>
        <% end %>
        <div class = "flex justify-end w-[20%]">
            <%= button_to "Проанализировать", folder_path(@media_item.folder_id), class: "h-16 w-[280px] bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg border-0 cursor-pointer hover:opacity-90" %>
        </div>
    </div>
</main>
<%= render template: "layouts/footer" %>