<main class="flex justify-center">
    <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center">
        <div class="text-[#333] text-[22px] font-bold">
            <span>Прикрепление куста</span>
        </div>
        <% flash.each do |type, msg| %>
            <div class = "mt-5 px-3 h-16 w-full border border-red-800 text-red-800 bg-red-200 rounded-lg flex items-center justify-center text-center">
                <%= msg %>
            </div>
        <% end %>
        <%= form_with model: @media_item, url: attach_to_bush_media_item_path(@media_item), html: { method: :post }, class: "mt-5 w-70", data: { controller: "bush-select" } do |form| %>
            <div class = "flex flex-col gap-5">
                <div>
                    <%= select_tag :vineyard_id, 
                        options_from_collection_for_select(@vineyards, :id, :name, @selected_vineyard_id),
                        include_blank: "- Выберите виноградник -",
                        required: true,
                        class: "w-full px-4 py-3 border border-[#e5e5e5] rounded-lg outline-none focus:border-[#69377c] focus:ring-1 focus:ring-[#69377c] bg-white",
                        data: { 
                        action: "change->bush-select#loadRows",
                        controller: "bush-select"
                        }
                    %>
                </div>
                
                <!-- Выбор ряда (появляется после выбора виноградника) -->
                <div id="rows-container" style="display: <%= @selected_vineyard_id ? 'block' : 'none' %>">
                    <%= select_tag :row_id,
                        options_from_collection_for_select(@rows || [], :id, :row_number, @selected_row_id),
                        include_blank: "- Выберите ряд -",
                        required: true,
                        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-[#69377c] focus:ring-1 focus:ring-[#69377c] bg-white",
                        data: { action: "change->bush-select#loadBushes" }
                    %>
                </div>
                
                <!-- Выбор куста (появляется после выбора ряда) -->
                <div id="bushes-container" style="display: <%= @selected_row_id ? 'block' : 'none' %>">
                    <%= select_tag :bush_id,
                        options_from_collection_for_select(@bushes || [], :id, :bush_number, @selected_bush_id),
                        include_blank: "- Выберите куст -",
                        required: true,
                        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-[#69377c] focus:ring-1 focus:ring-[#69377c] bg-white"
                    %>
                </div>
            </div>
            <%= form.submit 'Прикрепить', class: "h-16 w-full bg-gradient-to-b from-[#69377c] to-[#8a579f] text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90" %>
        <% end %>
        <%= link_to "Назад", "javascript:history.back()", class: "text-[#0d61af] text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-[#9330b7]" %>
    </div>
</main>