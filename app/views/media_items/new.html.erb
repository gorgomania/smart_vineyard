<main class="flex justify-center">
    <div class="my-28 w-80 bg-white rounded-2xl z-[2] p-5 flex flex-col items-center" data-controller="upload">
        <div class="text-ink text-[22px] font-bold">
            <span>Загрузка файлов</span>
        </div>
        <div id="error-container" data-upload-target="errorContainer">
            <%= render "shared/form_flash", width: "w-70" %>
        </div>
        <%= form_with model: @media_item, html: { method: :post, id: "media-upload-form" }, class: "mt-5", data: { "upload-target": "form", action: "submit->upload#submit" } do |form| %>
            <div class="space-y-3 w-70">
                <label id="dropZone" class="flex flex-col items-center justify-center gap-2 border-2 border-dashed border-brand-pale rounded-xl px-6 py-8 bg-brand-tint hover:border-brand-light hover:bg-brand-soft cursor-pointer transition"
                       data-upload-target="dropZone"
                       data-action="dragenter->upload#dragOver dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop">
                    <span class="text-sm text-ink-soft pointer-events-none">
                        Перетащите файлы сюда или нажмите для выбора
                    </span>
                    <%= form.file_field :media, multiple: true, accept: 'image/*,video/*,.zip,application/zip', direct_upload: true, id: "fileInput", class: "hidden",
                        data: { "upload-target": "fileInput", action: "change->upload#fileInputChange" } %>
                    <%= form.hidden_field :folder_id, value: @folder_id%>
                </label>
                <p class="text-xs text-slate-500 mb-0">
                    Форматы: JPG, PNG, WebP, MP4, ZIP<br>
                    Максимальный размер файла: 1 ГБ
                </p>
                <div id="preview-container" class="grid grid-cols-3 gap-4" data-upload-target="previewContainer"></div>
            </div>
            <div id="upload-progress-container" class="hidden mt-3" data-upload-target="progressContainer">
                <div class="flex justify-between text-xs text-gray-600 mb-1">
                    <span>Загрузка файлов:</span>
                    <span id="upload-progress-percent" data-upload-target="progressPercent">0%</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                    <div id="upload-progress-bar" class="bg-brand h-2 rounded-full transition-all duration-300" style="width: 0%" data-upload-target="progressBar"></div>
                </div>
                <p id="upload-progress-status" class="text-xs text-gray-500 mt-1 whitespace-pre-line" data-upload-target="progressStatus"></p>
            </div>
            <%= form.submit 'Загрузить', id: "newfile-submit-btn", class: "h-16 w-full bg-gradient-to-b from-brand to-brand-light text-white font-bold rounded-lg mt-5 border-0 cursor-pointer hover:opacity-90",
                data: { "upload-target": "submitBtn" } %>
        <% end %>
        <%= link_to "Назад", folder_path(@folder_id), data: { controller: "history", action: "upload#confirmLeave history#back" }, class: "text-link text-sm leading-5 mt-5 w-fit cursor-pointer hover:text-brand-bright" %>
    </div>
</main>
